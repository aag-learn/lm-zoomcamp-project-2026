# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed.

# Postgres credentials (required — no defaults; the app refuses to start
# without POSTGRES_PASSWORD set).
POSTGRES_USER=llm_zoomcamp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=llm_zoomcamp_development

# Host-side port mapping for the postgres service (optional — defaults to
# 5432 if unset; override if you already have a local Postgres on 5432).
POSTGRES_PORT=5432

# Host-side port mapping for the embedder sidecar (optional — defaults to
# 8001 if unset).
EMBEDDER_PORT=8001

# Rails credentials-decryption key (required in production — from
# rails_app/config/master.key, generated once by `rails new` and gitignored).
RAILS_MASTER_KEY=changeme

# Host-side port mapping for the web service (optional — defaults to 3000
# if unset).
WEB_PORT=3000

# OpenAI API key for the chat interface (required — no default; the app
# refuses to start chat requests without it). Needed by both `web` (enqueues
# ChatResponseJob) and `worker` (actually executes it via Solid Queue).
OPENAI_API_KEY=changeme

# Grafana admin login (required — no default; the monitoring dashboard's
# admin account uses this, distinct from the read-only Postgres role
# Grafana's own datasource connects with).
GRAFANA_ADMIN_PASSWORD=changeme

# Password for the read-only grafana_reader Postgres role (required — no
# default). Set here and used both when the role is auto-provisioned
# (rails_app/lib/tasks/grafana.rake, run from bin/docker-entrypoint) and in
# Grafana's own datasource provisioning config.
GRAFANA_DB_PASSWORD=changeme

# Host-side port mapping for the Grafana dashboard (optional — defaults to
# 3001 if unset; distinct from WEB_PORT's 3000 since Grafana's own image
# also listens on 3000 internally).
GRAFANA_PORT=3001

# Only consulted by locally-run (non-Docker) web/worker processes, to reach a
# locally-run embedder (`cd embedder && uv run uvicorn ...`). Has no effect
# on the containerized path — docker-compose.yml doesn't read this variable,
# so containers keep using their own internal default (http://embedder:8000).
EMBEDDER_URL=http://localhost:8000
