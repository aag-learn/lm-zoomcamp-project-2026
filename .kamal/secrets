# Reads from the real deployment secrets file (.env.production), not root
# .env — the two are deliberately separate, see design.md Decision 5. Never
# read by docker-compose.yml or bin/dev.
#
# CORRECTED DURING IMPLEMENTATION: this file is parsed by the `dotenv` gem
# (Kamal::Secrets, `Dotenv.parse`), not executed as a bash script — a plain
# `source ../.env.production` line here is not valid dotenv syntax and does
# nothing, silently leaving every key below resolving to an empty string
# (confirmed directly: `Dotenv.parse(".kamal/secrets")` returned every key
# with a 0-character value). Each line below instead uses Kamal's supported
# `$(...)` inline command substitution (Kamal::Secrets::Dotenv::
# InlineCommandSubstitution — real shell execution, one command per line) to
# extract its value directly from .env.production, whose values are single-
# quoted (see .env.production.example) so `cut -d "'" -f2` reliably isolates
# them. Path is `.env.production`, not `../.env.production` — Kamal evaluates
# these commands with the same working directory as the `kamal` invocation
# itself (the repo root, where config/deploy.yml lives), not relative to this
# file's own location inside .kamal/ (confirmed directly: `../.env.production`
# resolved one directory too far up and every key came back empty).

GHCR_USERNAME=$(grep -m1 "^GHCR_USERNAME=" .env.production | cut -d "'" -f2)
GHCR_TOKEN=$(grep -m1 "^GHCR_TOKEN=" .env.production | cut -d "'" -f2)
RAILS_MASTER_KEY=$(grep -m1 "^RAILS_MASTER_KEY=" .env.production | cut -d "'" -f2)
POSTGRES_PASSWORD=$(grep -m1 "^POSTGRES_PASSWORD=" .env.production | cut -d "'" -f2)
OPENAI_API_KEY=$(grep -m1 "^OPENAI_API_KEY=" .env.production | cut -d "'" -f2)
GRAFANA_DB_PASSWORD=$(grep -m1 "^GRAFANA_DB_PASSWORD=" .env.production | cut -d "'" -f2)
GRAFANA_ADMIN_PASSWORD=$(grep -m1 "^GRAFANA_ADMIN_PASSWORD=" .env.production | cut -d "'" -f2)
ADMIN_EMAIL=$(grep -m1 "^ADMIN_EMAIL=" .env.production | cut -d "'" -f2)
ADMIN_PASSWORD=$(grep -m1 "^ADMIN_PASSWORD=" .env.production | cut -d "'" -f2)
