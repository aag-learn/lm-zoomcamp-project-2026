# Copy this file to .env.production and fill in the REAL deployment secrets.
# .env.production is gitignored and must never be committed.
#
# Read ONLY by `.kamal/secrets` when running `kamal` commands — never by
# docker-compose.yml or bin/dev. Deliberately separate from root .env, whose
# values are for local development only and must stay distinct from these
# (see the production-deployment change's design.md, Decision 5).
#
# IMPORTANT: `.kamal/secrets` sources this file directly as a bash script
# (`source ../.env.production`), not as a plain dotenv file — an unquoted
# value containing shell-meta characters (parens, $, backticks, spaces, ! in
# interactive shells) will break parsing and silently skip every line after
# it. Wrap every value in single quotes, as below, regardless of whether the
# value looks like it needs it (discovered the hard way: a Postgres password
# containing unescaped parens aborted the source mid-file).

# GitHub Container Registry (ghcr.io) — used to push/pull the web/worker/
# embedder images. Packages are public (see design.md, Decision 1 correction).
# Must be a CLASSIC personal access token with the write:packages scope
# (which implies read:packages) — confirmed against GitHub's own docs that
# fine-grained PATs don't support GHCR at all (no "Packages" permission
# exists in that UI). GHCR_USERNAME is your GitHub login (may differ from
# the repo/org name in the image path).
GHCR_USERNAME='changeme'
GHCR_TOKEN='changeme'

# Rails credentials-decryption key (rails_app/config/master.key — the same
# key for every environment; Rails encrypts config/credentials.yml.enc with
# it once, regardless of where the app runs).
RAILS_MASTER_KEY='changeme'

# Production Postgres password — must NOT be the same value as root .env's
# local-dev POSTGRES_PASSWORD.
POSTGRES_PASSWORD='changeme'

# Production OpenAI API key — the one that incurs real billed usage. Must
# NOT be the same value as root .env's local-dev OPENAI_API_KEY.
OPENAI_API_KEY='changeme'

# Production Grafana admin login and grafana_reader Postgres role password.
GRAFANA_ADMIN_PASSWORD='changeme'
GRAFANA_DB_PASSWORD='changeme'

# The real operator account credentials for the deployed app — must NOT be
# the same value as root .env's local-dev ADMIN_EMAIL/ADMIN_PASSWORD.
ADMIN_EMAIL='changeme'
ADMIN_PASSWORD='changeme'
