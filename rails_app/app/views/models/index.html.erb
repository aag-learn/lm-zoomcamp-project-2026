<% content_for :title, "Models" %>

<div class="mx-auto w-full max-w-4xl">
  <div class="mb-4 flex items-center justify-between">
    <h1 class="text-2xl font-bold">Models</h1>
    <%= button_to "Refresh Models", refresh_models_path, method: :post, class: "cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" %>
  </div>

  <div id="models" class="overflow-x-auto">
    <% if @models.any? %>
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="py-2 pr-4">Provider</th>
            <th class="py-2 pr-4">Model</th>
            <th class="py-2 pr-4">Context Window</th>
            <th class="py-2 pr-4">$/1M tokens (In/Out)</th>
            <th class="py-2"></th>
          </tr>
        </thead>
        <tbody>
          <% @models.each do |model_info| %>
            <%= render "models/model",
              model: model_info %>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gray-500">No chat models found.</p>
    <% end %>
  </div>
</div>
