<% assistant ||= local_assigns[:message] %>
<div id="message_<%= assistant.id %>" class="message mb-5 rounded-r-md border-l-4 border-green-500 bg-green-50 p-3">
  <div class="mb-1 font-semibold">Assistant</div>
  <div id="message_<%= assistant.id %>_content" class="whitespace-pre-wrap"><%= assistant.content %></div>
  <%= render "messages/citations", message: assistant if assistant.retrieval_log %>
  <div class="mt-1 text-sm text-gray-500">
    <%= assistant.created_at&.strftime("%I:%M %p") %>
  </div>
  <div id="message_<%= assistant.id %>_feedback" class="mt-2">
    <%= render "messages/feedback", message: assistant %>
  </div>
</div>
