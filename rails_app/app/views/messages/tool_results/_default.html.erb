<% error_message = tool.tool_error_message %>
<% if error_message.present? %>
  <%= render "messages/error",
    message: tool,
    title: "Tool Result Error",
    error_message: error_message %>
<% else %>
  <div id="message_<%= tool.id %>" class="message mb-5 rounded-r-md border-l-4 border-gray-500 bg-gray-50 p-3">
    <div class="mb-1 font-semibold">Tool</div>
    <pre class="m-0 whitespace-pre-wrap"><%= tool.content.presence || "(no output)" %></pre>
    <div class="mt-1 text-sm text-gray-500">
      <%= tool.created_at&.strftime("%I:%M %p") %>
    </div>
  </div>
<% end %>
