<div id="message_<%= tool_calls.id %>" class="message mb-5 rounded-r-md border-l-4 border-gray-500 bg-gray-50 p-3">
  <div class="mb-1 font-semibold">Tool Call</div>
  <pre class="m-0 whitespace-pre-wrap"><%= tool_call.name %>(<%= tool_call.arguments.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") %>)</pre>
  <div class="mt-1 text-sm text-gray-500">
    <%= tool_calls.created_at&.strftime("%I:%M %p") %>
  </div>
</div>
