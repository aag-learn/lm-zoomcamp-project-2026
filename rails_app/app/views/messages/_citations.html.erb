<% log = message.retrieval_log %>
<div class="mt-2" data-controller="retrieval-details">
  <button type="button" class="text-sm text-blue-600 hover:underline" data-action="retrieval-details#open">
    View retrieval details
  </button>
  <dialog
    data-retrieval-details-target="dialog"
    class="fixed inset-0 m-auto w-full max-w-lg rounded-md bg-white p-4 shadow-lg backdrop:bg-black/50"
  >
    <div class="mb-3 flex items-center justify-between">
      <h2 class="font-semibold">Retrieval details</h2>
      <button type="button" class="text-gray-500 hover:text-gray-800" data-action="retrieval-details#close">
        &times;
      </button>
    </div>

    <dl class="mb-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
      <dt class="text-gray-500">Top module</dt>
      <dd><%= log.top_module || "—" %></dd>
      <dt class="text-gray-500">Ansible core version</dt>
      <dd><%= log.ansible_core_version || "—" %></dd>
      <dt class="text-gray-500">Cost</dt>
      <dd><%= log.cost ? number_to_currency(log.cost, precision: 4) : "—" %></dd>
      <dt class="text-gray-500">Response time</dt>
      <dd><%= log.response_time ? "#{log.response_time.round(2)}s" : "—" %></dd>
    </dl>

    <div class="text-sm">
      <div class="mb-1 font-semibold text-gray-700">Retrieved chunks</div>
      <% if log.retrieved_chunks.any? %>
        <ul class="space-y-1">
          <% log.retrieved_chunks.each do |chunk| %>
            <li class="flex items-center justify-between gap-2">
              <code class="rounded bg-gray-100 px-1 py-0.5 text-xs text-gray-700"><%= chunk["stable_id"] %></code>
              <span class="text-xs text-gray-500">score: <%= chunk["rerank_score"]&.round(3) %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500">No chunks were retrieved.</p>
      <% end %>
    </div>
  </dialog>
</div>
