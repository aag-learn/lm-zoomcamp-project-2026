<% content_for :title, "Chats" %>

<div class="mx-auto w-full max-w-3xl">
  <h1 class="mb-4 text-2xl font-bold">Chats</h1>

  <div id="chats" class="space-y-4">
    <% if @chats.any? %>
      <% @chats.each do |chat| %>
        <div class="rounded-md border border-gray-200 p-4">
          <%= render chat %>
          <div class="mt-3 flex gap-4 text-sm">
            <%= link_to "Show this chat", chat, class: "text-blue-600 hover:underline" %>
            <%= link_to "Destroy this chat", chat, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-gray-500">No chats found.</p>
    <% end %>
  </div>

  <%= link_to "New chat", new_chat_path, class: "mt-6 inline-block rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" %>
</div>
