<%= form_with(model: chat, url: chats_path) do |form| %>
  <% if chat.errors.any? %>
    <div class="mb-4 rounded-md bg-red-50 p-3 text-red-700">
      <h2 class="font-semibold"><%= pluralize(chat.errors.count, "error") %> prohibited this chat from being saved:</h2>

      <ul class="list-inside list-disc">
        <% chat.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :model, "Select AI model:", class: "mb-1 block font-medium" %>
    <%= form.select :model,
        options_for_select(@chat_models.map { |model| [model.label, model.id] }.unshift([default_model_display_name, nil]), @selected_model),
        {},
        class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
  </div>

  <div class="mb-3">
    <%= form.text_field :prompt, class: "w-full rounded-md border border-gray-300 px-3 py-2", placeholder: "What would you like to discuss?", autofocus: true %>
  </div>

  <div>
    <%= form.submit "Start new chat", class: "cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" %>
  </div>
<% end %>
