<%= turbo_stream_from "chat_#{@chat.id}" %>

<% content_for :title, "Chat" %>

<div class="mx-auto w-full max-w-2xl">
  <h1 class="mb-2 text-2xl font-bold">Chat <%= @chat.id %></h1>

  <p class="mb-4 text-gray-600">Using <strong><%= @chat.model&.label || default_model_display_name %></strong></p>

  <div id="messages">
    <% @chat.messages.where.not(id: nil).each do |message| %>
      <%= render message %>
    <% end %>
  </div>

  <div class="mt-8">
    <%= render "messages/form", chat: @chat, message: @message %>
  </div>

  <div class="mt-5">
    <%= link_to "Back to chats", chats_path, class: "text-blue-600 hover:underline" %>
  </div>
</div>
